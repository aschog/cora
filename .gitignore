# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/

# Virtual environments
.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
node_modules/

# Environment / secrets
.env

# OS
.DS_Store

# Local vector store (Chroma persistence)
# Everything cora keeps at runtime — except the folder a plugin is dropped into, which
# has to be there to drop one into. The entries are written per-child rather than as
# `.cora/`: git does not descend into an excluded directory, so a negation under one is
# never read.
.cora/*
!.cora/plugins/
.cora/plugins/*
!.cora/plugins/.gitkeep
e2e-artifacts/

# What an approved effect produced. The user's to keep, wherever `CORA_OUTPUT_PATH`
# points; this is the default, which lands beside the stores above rather than in them.
cora-output/

# The built docs site.
site/

# The editor's own workspace.
.obsidian/

# What a browser run leaves behind: the store it drove, the traces of a failed spec,
# and the report nobody committed to reading.
/frontends/react/ui/test-results/
/frontends/react/ui/playwright-report/
