#!/bin/sh
# Enforce Conventional Commits (https://www.conventionalcommits.org).
msg_file="$1"
first_line=$(head -n 1 "$msg_file")

# Allow git-generated messages.
case "$first_line" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'
if ! printf '%s\n' "$first_line" | grep -qE "$pattern"; then
  echo "commit-msg: not a Conventional Commit:" >&2
  echo "  $first_line" >&2
  echo "expected: <type>(<optional scope>): <description>" >&2
  echo "types: feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi
